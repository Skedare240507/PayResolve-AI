                  "",
                  "pm.test(\"Profile identity matches OPERATOR\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.username).to.eql('operator');",
                  "    pm.expect(json.role).to.eql('OPERATOR');",
                  "    pm.expect(json.authenticated).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Zero secrets leaked in response\", function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include('password');",
                  "    pm.expect(text).to.not.include('client_secret');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
