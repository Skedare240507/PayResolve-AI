        {
          "name": "13. RBAC Security - Viewer Forbidden on Action Approval",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Viewer approval attempt is rejected with 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test(\"Zero secrets leaked in error response\", function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include('password');",
                  "    pm.expect(text).to.not.include('client_secret');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/actions/{{actionId}}/approve",
