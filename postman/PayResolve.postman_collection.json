        {
          "name": "11. Write Security - CSRF Required on Action Approval",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"State mutating request without CSRF is rejected with 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "pm.test(\"Zero secrets leaked in error response\", function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include('password');",
                  "    pm.expect(text).to.not.include('client_secret');",
                  "    pm.expect(text).to.not.include('DATABASE_URL');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/actions/{{actionId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "actions", "{{actionId}}", "approve"]
            },
            "description": "Verifies that state-mutating POST requests without a valid CSRF token fail fast with HTTP 403."
          }
        },
        {
          "name": "12. Login as Viewer",
          "event": [
            {
              "listen": "test",
