                  "    pm.expect(text).to.not.include('client_secret');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/cases",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases"]
            },
            "description": "Lists payment exception queue items."
          }
        },
