                  "});",
                  "",
                  "pm.test(\"Queue response has content array\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('content');",
                  "    pm.expect(json.content).to.be.an('array');",
                  "    pm.expect(json.content.length).to.be.above(0);",
                  "    const first = json.content[0];",
                  "    pm.expect(first).to.have.property('id');",
                  "    pm.expect(first).to.have.property('type');",
                  "    pm.expect(first).to.have.property('status');",
                  "    pm.collectionVariables.set('caseId', first.id);",
                  "});",
                  "",
                  "pm.test(\"Zero secrets leaked in response\", function () {",
