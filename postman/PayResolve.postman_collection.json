  "item": [
    {
      "name": "offline",
      "description": "Offline automated test suite. Tests health, authentication, CSRF token management, exception queue inspection, case details, event inbox, actions list, audit trail, benchmark telemetry, CSRF write-protection, and RBAC 403 enforcement for VIEWER role.",
      "item": [
        {
          "name": "1. Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Health status is UP\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('object');",
                  "    pm.expect(json.status).to.eql('UP');",
                  "});",
                  "",
                  "pm.test(\"Zero secrets leaked in response\", function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include('password');",
                  "    pm.expect(text).to.not.include('client_secret');",
                  "    pm.expect(text).to.not.include('DATABASE_URL');",
                  "    pm.expect(text).to.not.include('GEMINI_API_KEY');",
                  "    pm.expect(text).to.not.include('GROQ_API_KEY');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            },
            "description": "Verifies actuator health liveness and readiness status without credentials."
          }
        },
        {
          "name": "2. Fetch CSRF Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"CSRF response shape is valid\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('object');",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json).to.have.property('headerName');",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('csrfToken', json.token);",
                  "});",
                  "",
                  "pm.test(\"Zero secrets leaked in response\", function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include('password');",
                  "    pm.expect(text).to.not.include('client_secret');",
                  "    pm.expect(text).to.not.include('DATABASE_URL');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/auth/csrf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "csrf"]
            },
            "description": "Fetches CSRF token and sets XSRF-TOKEN cookie for mutating operations."
          }
        },
        {
          "name": "3. Login as Operator",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Operator session established\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('object');",
                  "    pm.expect(json.username).to.eql(pm.variables.get('operatorUsername'));",
                  "    pm.expect(json.role).to.eql('OPERATOR');",
                  "    pm.expect(json.authenticated).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Zero secrets leaked in response\", function () {",
                  "    const text = pm.response.text();",
                  "    pm.expect(text).to.not.include('password');",
                  "    pm.expect(text).to.not.include(pm.variables.get('operatorPassword'));",
                  "    pm.expect(text).to.not.include('client_secret');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{operatorUsername}}\",\n  \"password\": \"{{operatorPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates operator credentials and creates HTTP session cookie."
          }
        },
        {
          "name": "4. Get Authenticated Profile (Operator)",
          "event": [
            {
              "listen": "test",
              "script": {
