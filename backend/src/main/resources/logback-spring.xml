<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <conversionRule conversionWord="maskedMsg" class="com.payresolve.common.MaskingMessageConverter" />
    <conversionRule conversionWord="maskedEx" class="com.payresolve.common.MaskingThrowableProxyConverter" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%clr(%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %maskedMsg%n%maskedEx</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Suppress verbose configuration dump from HikariConfig which prints jdbcUrl and username -->
    <logger name="com.zaxxer.hikari.HikariConfig" level="WARN" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>

